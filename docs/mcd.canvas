		{"id":"b7cd07f8f2f086e7","type":"text","text":"# event_log\n\n- `id uuid pk default gen_random_uuid()`\n- `host_id uuid fk references host(id) not null on delete cascade`\n- `user_agent varchar(512) not null`\n- `status enum(info, approved, security, warning) not null default info`\n- `description varchar(100)`\n- `created_at timestampz default now()`\n","x":894,"y":680,"width":660,"height":260}
