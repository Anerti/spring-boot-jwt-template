		{"id":"e9c96b7cca5a1a5a","type":"text","text":"# host\n\n- `id uuid pk default gen_random_uuid()`\n- `user_id uuid fk references user(id) not null on delete cascade`\n- `ip_address varchar(255) not null`\n- `status enum(authorized, banned) default authorized`\n- `last_seen_at timestampz default now()`\n- `updated_at timestampz`\n","x":894,"y":-169,"width":660,"height":409},
		{"id":"23d73d5db42ee1a9","type":"text","text":"# user\n\n- `id uuid pk default gen_random_uuid()`\n- `username varchar(50) unique not null`\n- `password varchar(255) not null`\n- `first_name varchar(100) not null`\n- `last_name varchar(100) not null`\n- `email varchar(100) unique not null`\n- `verified boolean default false`\n- `status enum(active, inactive, locked) default active`\n- `role enum(admin, customer) default customer`\n- `created_at timestampz default now()`\n- `updated_at timestampz`\n","x":-543,"y":-165,"width":615,"height":405},
