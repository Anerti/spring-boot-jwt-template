		{"id":"e9c96b7cca5a1a5a","type":"text","text":"# host\n\n- `id uuid pk default gen_random_uuid()`\n- `user_id uuid fk references user(id) not null on delete cascade`\n- `ip_address varchar(255) not null`\n- `user_agent varchar(512) not null`\n- `status enum(active, inactive, banned) default inactive`\n- `login_failed boolean default f`\n- `description varchar(100)`\n- `created_at timestampz default now()`\n- `updated_at timestampz`\n","x":920,"y":-169,"width":608,"height":409},
